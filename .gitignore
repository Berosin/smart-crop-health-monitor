# Python
__pycache__/
*.py[cod]
*.egg-info/

# Virtual environments
.venv/
venv/
env/

# Streamlit
.streamlit/secrets.toml

# Data / runtime artifacts (do not commit user uploads or DB)
database/*.db
database/*.sqlite*
data/uploads/*
data/samples/*
data/raw/*
data/processed/*
!data/.gitkeep
!data/raw/.gitkeep
!data/processed/.gitkeep

# Model weights / labels (large, regenerable) — matches nested model dirs too
models/**/*.h5
models/**/*.keras
models/**/*.pkl
models/**/*.joblib
models/**/*.json
!models/.gitkeep

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log
