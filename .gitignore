# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage

# Virtual environments
.venv/
venv/
env/

# Streamlit
.streamlit/secrets.toml

# Data / runtime artifacts (do not commit user uploads, DB, or generated data)
database/*.db
database/*.sqlite*
data/uploads/*
data/samples/*
data/raw/*
data/processed/*
!data/.gitkeep
!data/raw/.gitkeep
!data/processed/.gitkeep

# Trained model artifacts and generated evaluation output.
# Model weights should be distributed through Git LFS, a release asset, or
# external model storage rather than committed to the normal repository.
# See README's "Deployment" section: src/model_fetch.py downloads and
# extracts a models.zip release asset into this directory on first boot.
models/**
!models/.gitkeep
!models/environment_model/
!models/environment_model/metadata.json
models/**/*.h5
models/**/*.keras
models/**/*.pkl
models/**/*.joblib
models/**/*.npz
models/**/saved_model/
models/**/logs/
models/**/*.png

# The zip built for the GitHub Release upload (see README's Deployment
# section) — a local packaging artifact only, never committed.
/models.zip

# Local environment and generated reports
.env
.env.*
!.env.example
*.log
*.tmp

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/